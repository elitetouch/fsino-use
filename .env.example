# Backend API HOST ROOT — the code internally prepends /api/v1, so
# set this to the host only (matches the super-admin portal convention).
#   Local dev: NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#   Production: NEXT_PUBLIC_API_BASE_URL=https://api.fsinnovation.net
NEXT_PUBLIC_API_BASE_URL=https://api.fsinnovation.net

# Optional: app name shown in tab title + footer.
NEXT_PUBLIC_APP_NAME=Farm Support Innovation

# Google Play Store URL for the FarmSpeak Android app — used by the
# "Get it on Google Play" buttons on the landing page. Replace with the
# real listing URL once published.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.farmspeak.app

# Customer-support contact channels — powered on the /contact and
# /community pages. If either is unset the corresponding page hides
# the call-to-action and shows a soft "Coming soon" state instead.
#   PHONE   E.164 format so <a href="tel:..."> works on mobile and
#           WhatsApp click-to-chat links parse it correctly.
#   HOURS   Free text — shown next to the call button.
#   WA_GROUP  Full https://chat.whatsapp.com/… invite link. Users tap
#             through to a WhatsApp screen where they choose whether
#             to join — we never auto-add them.
NEXT_PUBLIC_SUPPORT_PHONE=+2348000000000
NEXT_PUBLIC_SUPPORT_HOURS=Weekdays 8am to 6pm WAT
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/replace-with-real-invite-code
